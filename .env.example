# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
API_BASE_URL=http://localhost:8001
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database (compose maps Postgres to host port 5433)
DATABASE_URL=postgresql+asyncpg://repo:repo@localhost:5433/repo_understanding
DATABASE_URL_SYNC=postgresql+psycopg://repo:repo@localhost:5433/repo_understanding

# Redis
REDIS_URL=redis://localhost:6379/0

# Git clones (Phase 0: shallow)
CLONE_ROOT=./data/clones
CLONE_DEPTH=1

# GitHub App (create at https://github.com/settings/apps)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# Session cookie
SESSION_COOKIE_NAME=repo_session
SESSION_MAX_AGE_SECONDS=604800

# LLM (Phase 0 Week 3 â€” leave blank until agent work)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Embeddings (Phase 2 P3 — empty provider uses deterministic mock)
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-code-3
EMBEDDING_DIMS=1024
